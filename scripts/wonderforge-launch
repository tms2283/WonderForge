#!/usr/bin/env python3
"""Start the private portal and open a normal sandboxed Chromium app window.

Runs as the signed-in unprivileged Linux account. Never run through sudo.
"""
import os
import urllib.parse
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path


def main():
    if os.geteuid() == 0:
        raise SystemExit('Do not launch the graphical maker desktop as root.')
    if not (os.getenv('DISPLAY') or os.getenv('WAYLAND_DISPLAY')):
        raise SystemExit('Log in to the normal graphical desktop first.')
    port = 20000 + os.getuid() % 25000
    url = 'http://127.0.0.1:%d/' % port

    def responding():
        try:
            with socket.create_connection(('127.0.0.1', port), timeout=.25):
                return True
        except OSError:
            return False

    if not responding():
        service_started = False
        if shutil.which('systemctl'):
            try:
                # A user systemd service may not inherit the compositor environment.
                # Import only session display/bus variables from this signed-in user.
                display_keys = [k for k in ('DISPLAY', 'WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR',
                                            'DBUS_SESSION_BUS_ADDRESS') if os.getenv(k)]
                if display_keys:
                    subprocess.run(['systemctl', '--user', 'import-environment', *display_keys],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   check=False, timeout=4)
                subprocess.run(['systemctl', '--user', 'start', 'wonderforge.service'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True, timeout=4)
                service_started = True
            except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
                pass
        if not service_started:
            subprocess.Popen([sys.executable, '/opt/wonderforge/server.py', '--user-port'],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True)
        for _ in range(24):
            if responding():
                break
            time.sleep(.15)
    if not responding():
        raise SystemExit('WonderForge local server could not start. Run: systemctl --user status wonderforge.service')

    # Bootstrap the portal using a 40-second one-use HMAC ticket. A distinct
    # HttpOnly cookie is set on first navigation, then the URL is redirected
    # back to /. The ticket becomes unusable even if a process argument remains
    # visible via /proc. The private signing key is mode 0600 in this home.
    sys.path.insert(0, '/opt/wonderforge')
    from portal_security import issue_ticket
    url = url + '?ticket=' + urllib.parse.quote(issue_ticket(), safe='')

    browser = next((shutil.which(b) for b in ('chromium', 'chromium-browser') if shutil.which(b)), None)
    if browser:
        userdata = Path.home() / '.config' / 'wonderforge' / 'chromium'
        userdata.mkdir(mode=0o700, parents=True, exist_ok=True)
        cmd = [browser, '--app=' + url, '--user-data-dir=' + str(userdata), '--no-first-run']
    else:
        fallback = shutil.which('xdg-open')
        if not fallback:
            raise SystemExit('No Chromium or browser opener installed.')
        cmd = [fallback, url]
    # Intentionally no --no-sandbox or remote debugging flags.
    return subprocess.call(cmd)


if __name__ == '__main__':
    sys.exit(main())
